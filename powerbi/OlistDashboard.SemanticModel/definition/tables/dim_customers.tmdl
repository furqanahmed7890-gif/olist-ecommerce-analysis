	partition dim_customers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_customers.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"customer_unique_id", type text}, {"state", type text}, {"segment", type text}, {"r_score", type number}, {"f_score", type number}, {"m_score", type number}, {"monetary", type number}, {"recency_days", type number}, {"cohort_month", type date}, {"first_category", type text}, {"first_order_late", type logical}, {"first_review_score", type number}, {"returned_180d", type logical}, {"ever_returned", type logical}}, "en-US"),
				    Added = Table.AddColumn(Typed, "first_delivery", each if [first_order_late] = true then "Late" else if [first_order_late] = false then "On time" else null, type text)
				in
				    Added

	annotation PBI_ResultType = Table

