table dim_customers
	lineageTag: 27109bb5-886b-4aca-8041-c34c06f02160

	measure 'Ever Returned Rate' = DIVIDE ( CALCULATE ( COUNTROWS ( dim_customers ), dim_customers[ever_returned] == TRUE (), NOT ISBLANK ( dim_customers[cohort_month] ) ), CALCULATE ( COUNTROWS ( dim_customers ), NOT ISBLANK ( dim_customers[cohort_month] ) ) )
		formatString: 0.0%
		lineageTag: c323c410-5a17-4d41-8320-ce7053f0a2bd

	measure 'Eligible Customers' = COUNTROWS ( FILTER ( dim_customers, NOT ISBLANK ( dim_customers[returned_180d] ) && dim_customers[cohort_month] >= DATE ( 2017, 1, 1 ) && dim_customers[cohort_month] <= DATE ( 2018, 2, 1 ) ) )
		formatString: #,0
		lineageTag: e4362d87-a1d5-4319-8f25-5b426f009525

	measure 'Return Rate 180d' = DIVIDE ( COUNTROWS ( FILTER ( dim_customers, dim_customers[returned_180d] == TRUE () && dim_customers[cohort_month] >= DATE ( 2017, 1, 1 ) && dim_customers[cohort_month] <= DATE ( 2018, 2, 1 ) ) ), [Eligible Customers] )
		formatString: 0.0%
		lineageTag: 5e33ccd4-3595-4c2a-99cb-db96962ec9bb

	measure 'Return Rate 180d (1,000+ customers)' = IF ( [Eligible Customers] >= 1000, [Return Rate 180d] )
		formatString: 0.0%
		lineageTag: 8d9e9e88-c1a5-4f5c-b1a5-354018a05a48

	measure 'Return Rate 180d (delivered first orders)' = IF ( NOT ISBLANK ( SELECTEDVALUE ( dim_customers[first_delivery] ) ), [Return Rate 180d] )
		formatString: 0.0%
		lineageTag: 4b82bdb5-b79b-4381-aa87-4edfc35053e3

