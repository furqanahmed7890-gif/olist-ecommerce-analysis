table fact_orders
	lineageTag: c44fc922-ee2e-497c-b312-361e1fb513fc

	measure Orders = COUNTROWS ( fact_orders )
		formatString: #,0
		lineageTag: 5fcc0ed3-a606-46d7-acad-dd9f84286b54

	measure Revenue = SUM ( fact_orders[payment_value] )
		formatString: #,0
		lineageTag: 9dea8bbd-a2b6-4c8d-9151-3d92b2710706

	measure Customers = DISTINCTCOUNT ( fact_orders[customer_unique_id] )
		formatString: #,0
		lineageTag: ff7d0e02-fa2c-414a-b621-9ec84a55f4c1

	measure 'Avg Order Value' = DIVIDE ( [Revenue], [Orders] )
		formatString: #,0.00
		lineageTag: 11f79772-08db-4569-83d4-914bda346716

	measure 'Delivered Orders' = CALCULATE ( [Orders], fact_orders[order_status] = "delivered", NOT ISBLANK ( fact_orders[is_late] ) )
		formatString: #,0
		lineageTag: c37b14a8-6f64-4056-a7c2-aef88a2bbce5

	measure 'Late Orders' = CALCULATE ( [Orders], fact_orders[order_status] = "delivered", fact_orders[is_late] = TRUE () )
		formatString: #,0
		lineageTag: 8603492d-d8a5-446b-98d9-1a70906737f3

	measure 'Late Rate' = DIVIDE ( [Late Orders], [Delivered Orders] )
		formatString: 0.0%
		lineageTag: d03a76b2-a184-456a-9487-3898fb4dbbae

	measure 'Avg Review' = AVERAGE ( fact_orders[review_score] )
		formatString: 0.00
		lineageTag: 1750bbaa-0d31-43c6-aab6-1cd905d1fd19

	measure 'Avg Review On Time' = CALCULATE ( [Avg Review], fact_orders[is_late] == FALSE () )
		formatString: 0.00
		lineageTag: 92f760c3-32d7-4ff6-9ba7-5bc1bb9f05bf

	measure 'Avg Review (delivered)' = CALCULATE ( [Avg Review], NOT ISBLANK ( fact_orders[is_late] ) )
		formatString: 0.00
		lineageTag: 2a0eeacb-fe8e-4b88-a993-4380307a2b21

	measure 'Avg Review Late' = CALCULATE ( [Avg Review], fact_orders[is_late] = TRUE () )
		formatString: 0.00
		lineageTag: 5c3759bd-bffc-4125-a31e-767b597e430e

	measure 'One Star Share' = DIVIDE ( CALCULATE ( [Orders], fact_orders[review_score] == 1 ), CALCULATE ( [Orders], NOT ISBLANK ( fact_orders[review_score] ) ) )
		formatString: 0.0%
		lineageTag: 549969ca-bb16-43d5-ae80-47cee2260cc0

	measure 'One Star Share (delivered)' = CALCULATE ( [One Star Share], NOT ISBLANK ( fact_orders[is_late] ) )
		formatString: 0.0%
		lineageTag: d337027c-f8ce-401f-8eb1-0e2659b0058c

	measure 'Late Share of Bad Reviews' = DIVIDE ( CALCULATE ( [Orders], fact_orders[review_score] <= 2, NOT ISBLANK ( fact_orders[review_score] ), fact_orders[is_late] == TRUE () ), CALCULATE ( [Orders], fact_orders[review_score] <= 2, NOT ISBLANK ( fact_orders[review_score] ), NOT ISBLANK ( fact_orders[is_late] ) ) )
		formatString: 0.0%
		lineageTag: bd420eeb-ca30-49df-be63-22c09b656c57

	measure 'Customer Share' = DIVIDE ( [Customers], CALCULATE ( [Customers], ALL ( dim_customers[segment] ) ) )
		formatString: 0.0%
		lineageTag: f4a2ad40-b08b-490b-ab23-3ad7c520ce26

	measure 'Segment Revenue Share' = DIVIDE ( [Revenue], CALCULATE ( [Revenue], ALL ( dim_customers[segment] ) ) )
		formatString: 0.0%
		lineageTag: bdd08b5d-684f-4010-ad11-b8096ca69c28

