// DAX measures for the Olist Power BI report.
// In Power BI Desktop: select the fact_orders table, then Modeling > New measure, and paste one at a time.
// Tables: fact_orders, dim_customers, cohort_retention, Date (see BUILD_GUIDE.md).

Orders = COUNTROWS ( fact_orders )

Revenue = SUM ( fact_orders[payment_value] )

Customers = DISTINCTCOUNT ( fact_orders[customer_unique_id] )

Avg Order Value = DIVIDE ( [Revenue], [Orders] )

Delivered Orders =
CALCULATE (
    [Orders],
    fact_orders[order_status] = "delivered",
    NOT ISBLANK ( fact_orders[is_late] )
)

Late Orders =
CALCULATE (
    [Orders],
    fact_orders[order_status] = "delivered",
    fact_orders[is_late] = TRUE ()
)

Late Rate = DIVIDE ( [Late Orders], [Delivered Orders] )

Avg Review = AVERAGE ( fact_orders[review_score] )

Avg Review On Time = CALCULATE ( [Avg Review], fact_orders[is_late] = FALSE () )

Avg Review Late = CALCULATE ( [Avg Review], fact_orders[is_late] = TRUE () )

Review Gap = [Avg Review Late] - [Avg Review On Time]

One Star Share =
DIVIDE (
    CALCULATE ( [Orders], fact_orders[review_score] = 1 ),
    CALCULATE ( [Orders], NOT ISBLANK ( fact_orders[review_score] ) )
)

Late Share of Bad Reviews =
DIVIDE (
    CALCULATE ( [Orders], fact_orders[review_score] <= 2, fact_orders[is_late] = TRUE () ),
    CALCULATE ( [Orders], fact_orders[review_score] <= 2, NOT ISBLANK ( fact_orders[is_late] ) )
)

Ever Returned Rate =
DIVIDE (
    CALCULATE ( COUNTROWS ( dim_customers ), dim_customers[ever_returned] = TRUE () ),
    CALCULATE ( COUNTROWS ( dim_customers ), NOT ISBLANK ( dim_customers[ever_returned] ) )
)

// Same fair window as the SQL analysis: first orders Jan 2017 - Feb 2018, so everyone had 180 days to return.
Return Rate 180d =
VAR Eligible =
    FILTER (
        dim_customers,
        NOT ISBLANK ( dim_customers[returned_180d] )
            && dim_customers[cohort_month] >= DATE ( 2017, 1, 1 )
            && dim_customers[cohort_month] <= DATE ( 2018, 2, 1 )
    )
RETURN
    DIVIDE (
        COUNTROWS ( FILTER ( Eligible, dim_customers[returned_180d] = TRUE () ) ),
        COUNTROWS ( Eligible )
    )

Segment Revenue Share =
DIVIDE ( [Revenue], CALCULATE ( [Revenue], ALL ( dim_customers[segment] ) ) )

// Calculated table (Modeling > New table), then mark it as the date table on the Date column.
Date =
ADDCOLUMNS (
    CALENDAR ( DATE ( 2017, 1, 1 ), DATE ( 2018, 8, 31 ) ),
    "Year", YEAR ( [Date] ),
    "Month", FORMAT ( [Date], "yyyy-mm" ),
    "Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 )
)
